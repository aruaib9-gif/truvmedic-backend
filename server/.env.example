# ---- Core (required) ------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/truvmedic
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# Public URL of the frontend — used in invite/reset links and email logos.
APP_URL=http://localhost:5173
# Comma-separated origins allowed to call this API. Empty = allow all (dev only).
CORS_ORIGINS=http://localhost:5173

# ---- First admin ----------------------------------------------------------
# Emails listed here are granted the admin role when they self-register.
BOOTSTRAP_ADMIN_EMAILS=
# Used by `npm run seed` to create an admin directly.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# ---- File uploads (Cloudinary) -------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=truvmedic

# ---- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=TRUV Medical <noreply@truvmedic.com>
NOTIFY_EMAIL=info@truvmedic.com
SUPPORT_EMAIL=info@truvmedic.com
SUPPORT_PHONE=+234 800 000 0000
LOGO_URL=

# ---- Chatbot (Anthropic) --------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
